# Where the FastAPI backend runs. Next forwards /api/* to it (see next.config.ts).
# Local: start it from the repo root with: uv run uvicorn tuvi_api.main:app --reload
API_ORIGIN=http://localhost:8000

# Better Auth runs inside this Next.js app and stores accounts in MongoDB.
# Match BETTER_AUTH_URL, MONGODB_URI and MONGODB_DATABASE with the backend's
# AUTH__BASE_URL, AUTH__MONGO_URI and AUTH__DATABASE_NAME, respectively.
# Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=tuvilm

# Email verification and password-reset mail is sent through Resend.
# Create an API key at https://resend.com/api-keys and verify the sending domain.
# Left empty in development, the email (with its link) is printed to the
# `pnpm dev` console instead; production refuses to send without them.
RESEND_API_KEY=
EMAIL_FROM="Thiên Hạc <no-reply@your-domain.com>"

# Google Cloud Console → APIs & Services → Credentials.
# Create an OAuth client with type Web application, not Desktop app.
# Keep the real credentials in .env.local; never commit the downloaded JSON.
# Authorized redirect URI (local):
# http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
