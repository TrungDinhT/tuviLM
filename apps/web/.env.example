# Where the FastAPI backend runs. Next forwards /api/* to it (see next.config.ts).
# Local: start it from the repo root with: uv run uvicorn tuvi_api.main:app --reload
API_ORIGIN=http://localhost:8000

# Login, email (Resend) and Google sign-in are configured on the API, in the
# repo root .env: AUTH__BASE_URL, AUTH__RESEND_API_KEY, AUTH__EMAIL_FROM,
# AUTH__GOOGLE_CLIENT_ID and AUTH__GOOGLE_CLIENT_SECRET.
