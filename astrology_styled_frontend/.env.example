# Base URL of the FastAPI backend under ../api/
# Start it from the repo root with: uv run uvicorn api.main:app --reload
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Better Auth runs inside this Next.js app and stores accounts in MongoDB.
# Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=tuvilm

# Google Cloud Console → APIs & Services → Credentials.
# Authorized redirect URI (local):
# http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
