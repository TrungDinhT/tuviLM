CONVERSATION_HISTORY_STORE__URI=mongodb://localhost:27017
CONVERSATION_HISTORY_STORE__DATABASE_NAME=tuvilm
CONVERSATION_HISTORY_STORE__TZ_AWARE=true
CONVERSATION_HISTORY_STORE__STALE_PENDING_AFTER_SECONDS=900

# Prefer Together through OpenRouter, then fall back by lowest latency.
STRENGTH_WEAKNESS__MODEL=openrouter:deepseek/deepseek-v4.1-flash
STRENGTH_WEAKNESS__PROVIDER=together
STRENGTH_WEAKNESS__ALLOW_FALLBACKS=true
STRENGTH_WEAKNESS__PROVIDER_SORT=latency
STRENGTH_WEAKNESS__REASONING_EFFORT=low
# Export OPENROUTER_API_KEY in the server's environment.

# Match Better Auth's URL and MongoDB settings in astrology_styled_frontend.
AUTH__BASE_URL=http://localhost:3000
AUTH__MONGO_URI=mongodb://localhost:27017
AUTH__DATABASE_NAME=tuvilm
